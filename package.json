{
  "name": "dsh-acp-config",
  "version": "0.1.0",
  "private": true,
  "description": "Visual ACP-mode configuration for DSH: inherit or override web plugin switches, pick the agent preset, and set the sandbox permission for `dsh --profile acp`.",
  "license": "MIT",
  "files": [
    "dist",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "docs/DESIGN.md",
    "scripts/acp-dump-check.mjs",
    "scripts/smoke.mjs",
    "README.md",
    "README.zh.md"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./client": "./dist/client.iife.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prebuild": "node scripts/clean.mjs",
    "build": "vp pack",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "test": "vp test run",
    "verify": "vp check && vp test run && vp pack",
    "smoke": "node scripts/smoke.mjs",
    "dump-check": "node scripts/acp-dump-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite-plus": "^1.3.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.15.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
